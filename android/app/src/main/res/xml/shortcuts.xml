<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press on the launcher icon: "Send clipboard" (ClipboardSendActivity). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="send_clipboard"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_clipboard"
        android:shortcutShortLabel="@string/shortcut_send_clipboard_short"
        android:shortcutLongLabel="@string/shortcut_send_clipboard_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="org.pepoconnect.app"
            android:targetClass="org.pepoconnect.app.ClipboardSendActivity"/>
    </shortcut>
</shortcuts>
